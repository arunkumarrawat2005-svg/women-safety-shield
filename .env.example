# ==========================================================
# Women Safety Shield - Environment Configuration
# ==========================================================

# Core Django Settings
SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,.fly.dev
CORS_ALLOW_ALL=False

# Shared Database (Postgres recommended for production: Neon, Supabase, Fly Postgres)
# Leave empty for local SQLite (db.sqlite3)
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Shared Redis Channel Layer (for Django Channels WebSocket sync across Vercel & Fly.io)
# e.g. Upstash Redis, Redis Cloud, Fly Redis
# Leave empty for InMemoryChannelLayer in local dev
REDIS_URL=rediss://default:password@hostname:6379

# Cross-Deployment WebSocket Host
# When deployed on Vercel, set this to your Fly.io WebSocket domain:
# e.g. women-safety-shield-ws.fly.dev
# Leave blank for local development (defaults to window.location.host)
WEBSOCKET_HOST=

# CSRF Trusted Origins (comma-separated)
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://*.fly.dev,http://localhost:8000

# Push Notifications (Firebase FCM)
FCM_SERVER_KEY=your_fcm_server_key

# SMS & Call Escalation (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Google Maps / Location
GOOGLE_MAPS_API_KEY=your_google_maps_key
